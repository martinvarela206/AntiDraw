{
  "name": "antidraw",
  "displayName": "%antidraw.displayName%",
  "description": "%antidraw.description%",
  "version": "0.103.45",
  "icon": "icon.png",
  "publisher": "martinvarela206",
  "author": {
    "name": "Martin Varela",
    "email": "martinvarela206@gmail.com",
    "url": "https://github.com/martinvarela206"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/martinvarela206/AntiDraw.git"
  },
  "homepage": "https://github.com/martinvarela206/AntiDraw#readme",
  "bugs": {
    "url": "https://github.com/martinvarela206/AntiDraw/issues"
  },
  "funding": "https://ko-fi.com/martinvarela206",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "keywords": [
    "svg",
    "vector",
    "editor",
    "figma",
    "coreldraw",
    "illustrator",
    "inkscape",
    "draw",
    "bezier",
    "canvas",
    "design",
    "graphic-design"
  ],
  "badges": [
    {
      "url": "https://img.shields.io/badge/License-Source--Available-blue.svg",
      "href": "https://github.com/martinvarela206/AntiDraw/blob/main/LICENSE",
      "description": "PolyForm Noncommercial License"
    },
    {
      "url": "https://img.shields.io/badge/Ko--fi-Support-FF5E5B.svg",
      "href": "https://ko-fi.com/martinvarela206",
      "description": "Support on Ko-fi"
    }
  ],
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "%antidraw.untrustedWorkspaces.description%"
    }
  },
  "activationEvents": [
    "onCustomEditor:antidraw.projectEditor",
    "onCustomEditor:antidraw.svgEditor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "antidraw.projectEditor",
        "displayName": "%antidraw.projectEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.adrw"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "antidraw.svgEditor",
        "displayName": "%antidraw.editor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.svg"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "antidraw.openEditor",
        "title": "%antidraw.command.openEditor%"
      },
      {
        "command": "antidraw.purgeMetadata",
        "title": "%antidraw.command.purgeMetadata%"
      }
    ]
  },
  "scripts": {
    "sync-icons": "node scripts/sync-icons.js",
    "build": "node esbuild.js",
    "build:prod": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p . --noEmit && tsc -p tsconfig.core.json",
    "compile:core": "tsc -p tsconfig.core.json",
    "lint": "tsc -p . --noEmit && tsc -p tsconfig.core.json && depcruise --config .dependency-cruiser.cjs src/webview",
    "lint:layers": "depcruise --config .dependency-cruiser.cjs src/webview",
    "test": "node scripts/run-tests.js",
    "test:property": "tsx scripts/test-property-based-geometry.ts",
    "test:e2e": "node dist/test/runTest.js",
    "bench": "node scripts/run-benchmarks.js",
    "version:sync": "node scripts/sync-version.js",
    "version:bump": "node scripts/sync-version.js",
    "package": "pnpm run build:prod && vsce package --no-dependencies",
    "package:pre-release": "pnpm run build:prod && vsce package --no-dependencies --pre-release",
    "publish:marketplace": "vsce publish --no-dependencies",
    "publish:openvsx": "npx -y ovsx publish antidraw-0.103.45.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "@xmldom/xmldom": "^0.9.12",
    "dependency-cruiser": "^18.7.2",
    "esbuild": "^0.20.0",
    "fast-check": "^4.10.2",
    "linkedom": "^0.18.13",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "polygon-clipping": "^0.15.7"
  }
}
